# =============================================================================
# .env.example  —  Copy to .env and fill in your real values.
#                  NEVER commit .env (it is in .gitignore).
# =============================================================================

# ----------------------------------------------------------------------------
# OpenRouter (default LLM judge backend)
# Get your key at https://openrouter.ai/keys
# Format: sk-or-v1-<64 hex chars>
# The code reads this via os.environ.get("OPENROUTER_API_KEY").
# If unset, the judge falls back to BYPASS (safe fail-closed).
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY

# Optional: override the judge model (default: nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ----------------------------------------------------------------------------
# Google Gemini (alternative judge backend)
# Get your key at https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# OpenAI (used for embedding or auxiliary LLM calls)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# Vector Store / Cache
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional R3 gateway extension. app_from_env never loads this file implicitly.
# Default remains exact; shadow observes candidates without semantic serving.
# GATEWAY_CACHE_MODE=shadow
# GATEWAY_CACHE_POLICY=pinned_context
# GATEWAY_DOCUMENT_PROMPT_FILE=/absolute/path/to/fixed-evidence-and-instructions.txt
# GATEWAY_KNOWLEDGE_BASE=python-docs
# GATEWAY_KNOWLEDGE_REVISION=immutable-content-revision
# GATEWAY_ACCESS_SCOPE=approved-public-docs
# GATEWAY_SCOPE_POLICY_VERSION=operator-policy-revision
# GATEWAY_SEMANTIC_ENCODER=lexical
# Optional dense encoder: immutable revision must already be available locally.
# GATEWAY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GATEWAY_EMBEDDING_REVISION=full-immutable-model-commit
# Guarded mode requires explicit actual-answer bindings; unknown pairs abstain.
# GATEWAY_SEMANTIC_APPROVALS=/absolute/path/to/operator-approvals.json
